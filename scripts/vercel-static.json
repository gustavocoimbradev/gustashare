{
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/GustaShare-Setup.exe",
      "destination": "https://github.com/gustavocoimbradev/gustashare/releases/latest/download/GustaShare-Setup.exe",
      "permanent": false
    },
    {
      "source": "/GustaShare-Portable.exe",
      "destination": "https://github.com/gustavocoimbradev/gustashare/releases/latest/download/GustaShare-Setup.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/room/:code",
      "destination": "/index.html"
    }
  ]
}
