{
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/GustaShare-Portable.exe",
      "destination": "https://github.com/gustavocoimbradev/gustashare/releases/latest/download/GustaShare-Portable.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/room/:code", "destination": "/index.html" }
  ]
}
