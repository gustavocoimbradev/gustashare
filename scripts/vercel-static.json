{
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/GustaShare-Portable.exe",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/room/:code", "destination": "/index.html" }
  ]
}
