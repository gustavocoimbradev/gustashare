{
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/GustaShare-Portable.exe",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/room/:code", "destination": "/room.html" }
  ]
}
