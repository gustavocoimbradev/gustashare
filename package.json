{
  "name": "gustashare",
  "version": "1.0.35",
  "private": true,
  "description": "GustaShare",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:web": "vite",
    "build-native": "cd native/gustashare-capture && npm install && npm run build",
    "build": "vite build && electron-builder --win nsis --publish never",
    "build:web": "vite build --base / && node scripts/prepare-web-dist.js",
    "vercel-build": "vite build --base / && node scripts/prepare-web-dist.js",
    "build-local": "vite build && electron-builder --win nsis --publish never -c.directories.output=.",
    "bump-version": "node scripts/bump-version.js",
    "sync-update-server": "node scripts/sync-update-server.js",
    "deploy-worker": "cd cloudflare-worker && npx wrangler deploy",
    "publish": "git add . && git pull && git commit -m \"publish\" && git push && npm run deploy-worker"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gustashare.app",
    "productName": "GustaShare",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "native/gustashare-capture/index.js",
      "native/gustashare-capture/*.node"
    ],
    "asarUnpack": [
      "native/gustashare-capture/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GustaShare",
      "uninstallDisplayName": "GustaShare",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "GustaShare-Setup.exe"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.4.1": true
  }
}
