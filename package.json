{
  "name": "gustashare",
  "version": "1.0.7",
  "private": true,
  "description": "GustaShare",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build-native": "cd native/gustashare-capture && npm install && npm run build",
    "build": "vite build && electron-builder --win portable",
    "vercel-build": "node -e \"console.error('GustaShare: a Vercel nao deve buildar o app Electron. O site e o update-server/, publicado pelo GitHub Actions (vercel deploy). Desligue Git deploys neste projeto e ignore este build.'); process.exit(1)\"",
    "build-local": "vite build && electron-builder --win portable -c.directories.output=.",
    "bump-version": "node scripts/bump-version.js",
    "sync-update-server": "node scripts/sync-update-server.js",
    "publish": "git add . && git pull && git commit -m \"publish\" && git push"
  },
  "dependencies": { 
    "lucide-react": "^1.47.0",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gustashare.app",
    "productName": "GustaShare",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "native/gustashare-capture/index.js",
      "native/gustashare-capture/*.node"
    ],
    "asarUnpack": [
      "native/gustashare-capture/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "GustaShare-Portable.exe"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.4.1": true
  }
}
